#!/usr/bin/env bash
# Fake `adlc` (the pinned @adlc/cli) for offline tests. Scripts that call adlc honour FACTORY_ADLC
# (default `npx -y @adlc/cli@1.12.0`); tests point it here. tests/fakes/lib.sh sets the log.
#
# Records every call as one JSON array of its argv in $FAKE_ADLC_LOG (required) and answers with
# the shapes adlc 1.12.0 prints (measured in specs/factory-step1-v1/records/TB4.md):
#   The ticket store is $FAKE_ADLC_STORE (a file holding a JSON array of tickets; `ticket complete
#   --write` rewrites it) if set, else $FAKE_ADLC_TICKETS (a JSON array, read-only, default []).
#   A ticket is {id, title, body?, edges?, rails?, completed?, ticketHash?}; a missing ticketHash is
#   "hash-<id>" (except in `ticket list`, which echoes only the fields the fixture gave). The store is
#   frozen (adlc 1.12.0's "frozen trust root") once any ticket declares a non-empty `rails`,
#   completed ones included.
#   ticket list --json        [{id, title, ticketHash}] for every ticket, completed ones included
#   ticket show <id> --json   {ticket: {...every field the fixture gave but ticketHash, rails
#                             included}, ticketHash, storeHash}; an unknown id exits 2 with
#                             {"ok": false, "code": "TICKET_NOT_FOUND", ...} on stderr and nothing
#                             on stdout (as the real CLI; `ticket complete` the same)
#   ticket complete <id> [--write --authorize] [--json]
#                             only with FAKE_ADLC_STORE (else an unknown verb, exit 2). Prints
#                             the plan; with --write also sets completed: true in the store
#                             (a no-op when it already is, as the real CLI) and appends a
#                             ticket-complete entry to ./.adlc/manifest.jsonl, then prints
#                             {"applied": true, ...}. --write without --authorize exits 2 here, so
#                             a caller that forgets the flag the ticket names is caught. In a frozen
#                             store --write without --allow-unsigned prints the plan, then exits 2
#                             with {"ok": false, "code": "MANIFEST_KEY_REQUIRED", ...} on stderr
#                             and changes nothing; with it, a warning on stderr and the entry's
#                             data gains bypass: true. An unfrozen store takes the flag silently
#                             (all as the real CLI, specs/factory-run-calls-v1/records/TB2.md §1).
#   gate-manifest show [--ticket id] --json
#                             {entries: [...], skipped: $FAKE_ADLC_SKIPPED (default [])} from
#                             ./.adlc/manifest.jsonl (cwd, as the real CLI); each entry gains
#                             gate = (.gate // .type) and segment "root"
#   merge-forecast --json ... $FAKE_ADLC_FORECAST (a JSON object, default: every open ticket in
#                             one wave, mergeOrder = sorted ids, certifiedWidth = their count;
#                             no open ticket: exits 1, "no active tickets found", as the real CLI does),
#                             then exits $FAKE_ADLC_FORECAST_EXIT (default 0; the real CLI exits 2
#                             when a gate fails and still prints the forecast)
#   FAKE_ADLC_FAIL            ERE; a call whose joined argv matches exits 1 with nothing on stdout
#   FAKE_ADLC_GITSTORE=1      the store is the real layout in the cwd's repository (make sim): one
#                             file per ticket in <toplevel>/.adlc/tickets/<slug>--<sha256 of the id>.json
#                             as adlc names it (tickets/lib/filename.mjs: the slug is the lowercased id,
#                             runs of other characters `-`; lib/diff-gates.sh reads a ticket from a base
#                             commit by that name) (.store.json is skipped), ticketHash = sha256 of the sorted compact
#                             ticket JSON. Adds the writes adlc 1.12.0 has (measured 2026-10-26 in a
#                             scratch store, specs/factory-step3-v1/records/TB1.md): `ticket create
#                             --input F --write [--allow-unsigned] [--json]` (an edge target must exist,
#                             a frozen store needs --allow-unsigned), `ticket complete` (as above, on
#                             the file), `gate-manifest record <gate> --ticket id --data json` (appends
#                             {seq, gate, ticket, data}), and `merge-forecast --json` from the edges:
#                             waves are Kahn levels over the open tickets (an edge {to: C} on P makes C
#                             wait for P while P is open), mergeOrder the waves flattened. FAKE_ADLC_STORE
#                             and FAKE_ADLC_TICKETS are ignored in this mode.
#                             The manifest is hash-chained as adlc's (gate-manifest lib/record.mjs:117-131,
#                             measured in specs/factory-step3-v1/records/TB7.md): seq = the previous
#                             entry's seq + 1, prev = sha256 of the previous raw line (null on the first).
#                             More verbs of 1.12.0 in this mode (TB7):
#                             `gate-manifest verify --json` ({valid, message, count, segments: 0,
#                             signed: false, break}; a seq or prev mismatch exits 2 with the message
#                             on stderr, as verify.mjs:134), `ticket doctor --json` ({exitCode, ok,
#                             checks}; a broken chain fails store:storehash-manifest-bind with
#                             MANIFEST_CHAIN_INVALID, and a .adlc/ticket-archive/.store.json whose format
#                             is not adlc-ticket-archive v1 fails store:archive, each exit 2), `coldstart <id> --offline --json`
#                             (coldstart lib/gate.mjs:213-280: body, scope, rails and edge targets;
#                             exit 2 on a gap) and `coldstart <id> --prompt-only --record-verdict -`
#                             (appends {gate: coldstart, ticket, data: {promptOnly, usageStatus,
#                             verdict, ticketIds, tier}} as lib/verdict.mjs:58-68), and the forecast's
#                             `ticket "<id>" has no scope defined` / `scope matches 0 files in repo`
#                             warnings (merge-forecast lib/forecast.mjs:69-72; a bash pattern stands in
#                             for adlc's glob).
#   spec-lint <file> [--json] [--record --ticket id [--dir D]]
#                             (either mode; spec-lint bin/spec-lint.mjs, lib/parse.mjs, lib/record.mjs):
#                             the criteria are the list items under a heading (`#…` or a bold-only
#                             line) matching acceptance|criteria|requirements|definition of done|
#                             success; one is verified when it says `Verify: <x>`, `verified by <x>`
#                             or carries a backticked command. Zero criteria or a wish exits 2;
#                             a pass with --record appends {gate: spec-lint, ticket, data: {verified:
#                             true}, files: {<file as given>: sha256}} to D/manifest.jsonl (D default
#                             ./.adlc), chained as above.
# Anything else exits 2 so a script never relies on a verb the fake does not know.
set -euo pipefail
: "${FAKE_ADLC_LOG:?fake adlc needs FAKE_ADLC_LOG}"
for a in "$@"; do jq -n --arg a "$a" '$a'; done | jq -sc . >>"$FAKE_ADLC_LOG"
if [ -n "${FAKE_ADLC_FAIL:-}" ] && [[ "$*" =~ $FAKE_ADLC_FAIL ]]; then
  echo "adlc: injected failure" >&2; exit 1
fi
if [ -n "${FAKE_ADLC_STORE:-}" ]; then raw="$(jq -c . "$FAKE_ADLC_STORE")"; else raw="${FAKE_ADLC_TICKETS:-[]}"; fi
tickets="$(jq -c 'map({ticketHash: "hash-\(.id)"} + .)' <<<"$raw")"
has() { local a; for a in "${@:2}"; do [ "$a" = "$1" ] && return 0; done; return 1; }
not_found() {
  jq -cn --arg id "$1" '{ok: false, kind: "invalid", code: "TICKET_NOT_FOUND", message: "ticket not found: \($id)"}' >&2
  exit 2
}
MANIFEST=.adlc/manifest.jsonl
sha256() { sha256sum | cut -d' ' -f1; }
chain_append() {  # chain_append <manifest> <entry-json>: seq and prev as adlc's record.mjs
  local m="$1" last="" seq=1 prev=null
  if [ -s "$m" ]; then
    last="$(tail -n1 "$m")"
    seq="$(( $(jq -r '.seq' <<<"$last") + 1 ))"
    prev="\"$(printf '%s' "$last" | sha256)\""
  fi
  jq -c --argjson s "$seq" --argjson p "$prev" '{seq: $s} + . + {prev: $p}' <<<"$2" >>"$m"
  printf '%s\n' "$seq"
}

if [ "${1:-}" = spec-lint ]; then
  file="${2:?fake adlc: spec-lint needs a file}" json=0 rec=0 id="" dir=.adlc
  set -- "${@:3}"
  while [ $# -gt 0 ]; do
    case "$1" in --json) json=1 ;; --record) rec=1 ;; --ticket) id="$2"; shift ;; --dir) dir="$2"; shift ;;
      *) echo "fake adlc: spec-lint: unsupported $1" >&2; exit 2 ;; esac
    shift
  done
  [ -f "$file" ] || { echo "spec-lint: cannot read $file" >&2; exit 1; }
  [ "$rec" = 0 ] || [ -n "$id" ] || { echo "--record requires --ticket" >&2; exit 1; }
  res="$(jq -Rsc --arg f "$file" '
    split("\n") | reduce .[] as $l ({in: false, c: []};
      if ($l | test("^#{1,6}\\s+")) then .in = ($l | sub("^#{1,6}\\s+"; "") | test("acceptance|criteria|requirements|definition of done|success"; "i"))
      elif ($l | test("^\\*\\*((?!\\*\\*).)+\\*\\*:?\\s*$")) then .in = ($l | test("acceptance|criteria|requirements|definition of done|success"; "i"))
      elif .in and ($l | test("^[ \t]*(?:[-*]|\\d+\\.)\\s+\\S")) then
        .c += [{text: ($l | sub("^[ \t]*(?:[-*]|\\d+\\.)\\s+"; "")),
                status: (if ($l | test("(verify\\s*:|verified\\s+by)\\s+\\S"; "i") or test("`[^`]+`")) then "VERIFIED" else "WISH" end)}]
      else . end)
    | {file: $f, total: (.c | length), verified: ([.c[] | select(.status == "VERIFIED")] | length),
       wishes: ([.c[] | select(.status == "WISH")] | length), criteria: .c}' "$file")"
  [ "$json" = 0 ] || printf '%s\n' "$res"
  if [ "$(jq .total <<<"$res")" = 0 ]; then echo "spec-lint: no acceptance criteria found." >&2; exit 2; fi
  if [ "$(jq .wishes <<<"$res")" != 0 ]; then echo "spec-lint: $(jq .wishes <<<"$res") wish(es) found" >&2; exit 2; fi
  if [ "$rec" = 1 ]; then
    mkdir -p "$dir"
    chain_append "$dir/manifest.jsonl" "$(jq -cn --arg t "$id" --arg f "$file" --arg h "$(sha256 <"$file")" \
      '{gate: "spec-lint", ticket: $t, data: {verified: true}, files: {($f): $h}}')" >/dev/null
  fi
  [ "$json" = 1 ] || echo "spec-lint: all criteria verified."
  exit 0
fi

if [ "${FAKE_ADLC_GITSTORE:-0}" = 1 ]; then
  TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo '{"ok":false,"code":"STORE_NOT_FOUND"}' >&2; exit 2; }
  SDIR="$TOP/.adlc/tickets"
  [ -f "$SDIR/.store.json" ] || { echo '{"ok":false,"code":"STORE_NOT_FOUND"}' >&2; exit 2; }
  gs_all() { local f; for f in "$SDIR"/*.json; do [ -e "$f" ] || continue; jq -cS . "$f"; done | jq -sc 'sort_by(.id)'; }
  gs_hash() { jq -cS . | sha256sum | cut -d' ' -f1; }
  gs_file() { local f; for f in "$SDIR"/*.json; do [ -e "$f" ] && [ "$(jq -r .id "$f")" = "$1" ] && { echo "$f"; return 0; }; done; return 1; }
  gs_put() {  # gs_put <ticket-json>: replace the ticket's file
    local old id h lid; id="$(jq -r .id <<<"$1")"; old="$(gs_file "$id" || true)"
    h="$(printf '%s' "$id" | sha256sum | cut -d' ' -f1)"
    lid="$(jq -r '.id | ascii_downcase | gsub("[^a-z0-9]+"; "-") | ltrimstr("-") | rtrimstr("-") | .[:48] | rtrimstr("-") | if . == "" then "ticket" else . end' <<<"$1")"
    [ -z "$old" ] || rm -f "$old"
    jq -S . <<<"$1" >"$SDIR/$lid--$h.json"
  }
  gs_append() { chain_append "$TOP/.adlc/manifest.jsonl" "$1" >/dev/null; }
  gs_verify() {  # {valid, message, count, segments, signed, break} of the root manifest's chain
    local m="$TOP/.adlc/manifest.jsonl"
    { [ -f "$m" ] && command cat "$m"; true; } | jq -Rsc '
      split("\n") | map(select(. != "")) as $l
      | (first(range(0; $l | length) as $i | ($l[$i] | fromjson) as $e
          | select($e.seq != $i + 1 or $e.prev != (if $i == 0 then null else $sha[$i - 1] end))
          | {seq: $e.seq, lineNo: ($i + 1), reason: (if $e.seq != $i + 1 then "seq mismatch" else "prev hash mismatch" end),
             segment: "root"}) // null) as $b
      | {valid: ($b == null),
         message: (if $b == null then "manifest ok (\($l | length) entries)"
                   else "chain broken at seq \($b.seq) (line \($b.lineNo)): \($b.reason)" end),
         count: ($l | length), segments: 0, signed: false, break: $b}' \
      --argjson sha "$({ [ -f "$m" ] && command cat "$m"; true; } | while IFS= read -r line; do printf '%s' "$line" | sha256; done | jq -Rsc 'split("\n") | map(select(. != ""))')"
  }
  gs_frozen() { jq -e 'any(.[]; (.rails | type) == "array" and (.rails | length) > 0)' <<<"$(gs_all)" >/dev/null; }
  gs_unsigned() {  # a frozen store's write: refused without --allow-unsigned (exit 2), else warned
    gs_frozen || return 0
    has --allow-unsigned "$@" || { jq -cn '{ok: false, kind: "policy", code: "MANIFEST_KEY_REQUIRED"}' >&2; exit 2; }
    echo "warning: --allow-unsigned with no ADLC_MANIFEST_KEY — this mutation of a frozen trust root will be recorded UNSIGNED." >&2
  }
  all="$(gs_all)"
  case "${1:-} ${2:-}" in
    "ticket list")
      while IFS= read -r t; do jq -c --arg h "$(gs_hash <<<"$t")" '{id, title, ticketHash: $h}' <<<"$t"; done < <(jq -c '.[]' <<<"$all") | jq -sc . ;;
    "ticket show")
      id="${3:?fake adlc: ticket show needs an id}"
      t="$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<<"$all")"
      [ -n "$t" ] || not_found "$id"
      jq -c --arg h "$(gs_hash <<<"$t")" --arg s "$(gs_hash <<<"$all")" '{ticket: ., ticketHash: $h, storeHash: $s}' <<<"$t" ;;
    "ticket create")
      in="" prev=""; for a in "${@:3}"; do [ "$prev" = --input ] && in="$a"; prev="$a"; done
      t="$(jq -cS . "${in:?fake adlc: ticket create needs --input}")" || exit 2
      id="$(jq -r .id <<<"$t")"
      jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$all" >/dev/null && { echo '{"ok":false,"code":"TICKET_EXISTS"}' >&2; exit 2; }
      missing="$(jq -r --argjson all "$all" '[.edges[]?.to] - [$all[].id] | .[0] // empty' <<<"$t")"
      [ -z "$missing" ] || { jq -cn --arg m "$missing" '{ok: false, code: "EDGE_TARGET_NOT_FOUND", message: "edge target not found: \($m)"}' >&2; exit 2; }
      jq -cn --arg id "$id" '{version: 1, operation: "create", ticketId: $id}'
      if has --write "${@:3}"; then
        gs_unsigned "${@:3}"
        gs_put "$t"
        gs_append "$(jq -cn --arg id "$id" --arg h "$(gs_hash <<<"$t")" '{gate: "ticket-mutation", ticket: $id, data: {operation: "create", action: "apply", ticketHash: $h}}')"
      fi ;;
    "ticket complete")
      id="${3:?fake adlc: ticket complete needs an id}"
      t="$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<<"$all")"
      [ -n "$t" ] || not_found "$id"
      jq -cn --arg id "$id" '{version: 1, operation: "complete", ticketId: $id, changedFields: ["completed"]}'
      if has --write "${@:4}"; then
        has --authorize "${@:4}" || { echo "fake adlc: complete --write needs --authorize in this fake" >&2; exit 2; }
        gs_unsigned "${@:4}"
        t="$(jq -c '.completed = true' <<<"$t")"
        gs_put "$t"
        gs_append "$(jq -cn --arg id "$id" '{gate: "ticket-complete", ticket: $id, data: {operation: "complete", action: "apply", bypass: true}}')"
        jq -cn --arg h "$(gs_hash <<<"$t")" '{applied: true, ticketHash: $h}'
      fi ;;
    "gate-manifest record")
      gate="${3:?fake adlc: gate-manifest record needs a gate}" id="" data='{}'
      set -- "${@:4}"
      while [ $# -gt 0 ]; do
        case "$1" in --ticket) id="$2"; shift ;; --data) data="$2"; shift ;; *) echo "fake adlc: record: unsupported $1" >&2; exit 2 ;; esac
        shift
      done
      gs_append "$(jq -cn --arg g "$gate" --arg t "$id" --argjson d "$data" '{gate: $g, ticket: $t, data: $d}')"
      echo "recorded: gate=$gate (unsigned)" ;;
    "gate-manifest show")
      want="" prev=""; for a in "${@:3}"; do [ "$prev" = --ticket ] && want="$a"; prev="$a"; done
      { [ -f "$TOP/.adlc/manifest.jsonl" ] && command cat "$TOP/.adlc/manifest.jsonl"; true; } |
        jq -sc --arg t "$want" '{entries: [.[] | select($t == "" or .ticket == $t) | . + {segment: "root"}], skipped: []}' ;;
    "gate-manifest verify")
      v="$(gs_verify)"
      has --json "${@:3}" && printf '%s\n' "$v" || jq -r .message <<<"$v"
      jq -e .valid <<<"$v" >/dev/null || { echo "gate-manifest verify: $(jq -r .message <<<"$v")" >&2; exit 2; }
      ;;
    "ticket doctor")
      v="$(gs_verify)"
      # The archive's own format marker, if the directory exists (real doctor: store:archive).
      arch=true
      [ ! -f "$TOP/.adlc/ticket-archive/.store.json" ] ||
        jq -e '.format == "adlc-ticket-archive" and .version == 1' "$TOP/.adlc/ticket-archive/.store.json" >/dev/null 2>&1 || arch=false
      d="$(jq -c --argjson arch "$arch" '(.valid) as $chain | ($chain and $arch) as $ok
        | {exitCode: (if $ok then 0 else 2 end), ok: $ok,
           checks: [{name: "config-valid", ok: true, detail: null}, {name: "tickets-load", ok: true, detail: null},
                    {name: "store:archive", ok: $arch,
                     detail: (if $arch then null else "unsupported ticket store manifest (expected format version 1)" end)},
                    {name: "store:storehash-manifest-bind", ok: $chain, detail: (if $chain then null else "MANIFEST_CHAIN_INVALID" end)}]}' <<<"$v")"
      if has --json "${@:3}"; then printf '%s\n' "$d"
      else jq -r '.checks[] | "  \(if .ok then "ok" else "FAIL" end)\t\(.name)\(if .detail then " \(.detail)" else "" end)"' <<<"$d"; fi
      [ "$(jq .exitCode <<<"$d")" = 0 ] || exit 2 ;;
    "coldstart "*)
      id="${2:?fake adlc: coldstart needs a ticket id}"
      t="$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<<"$all")"
      [ -n "$t" ] || { echo "coldstart: ticket not found: $id" >&2; exit 1; }
      if has --prompt-only "${@:3}"; then
        prev=""; src=""; for a in "${@:3}"; do [ "$prev" = --record-verdict ] && src="$a"; prev="$a"; done
        echo "=== user ($id) ==="
        [ -n "$src" ] || exit 0
        if [ "$src" = - ]; then verdict="$(command cat)"; else verdict="$(command cat "$src")"; fi
        [ -n "$verdict" ] || { echo "--record-verdict: empty" >&2; exit 1; }
        seq="$(chain_append "$TOP/.adlc/manifest.jsonl" "$(jq -cn --arg id "$id" --arg v "$verdict" \
          '{gate: "coldstart", ticket: $id, data: {promptOnly: true, usageStatus: "unreported", verdict: $v, ticketIds: [$id], tier: "cheap"}}')")"
        echo "gate-manifest: recorded seq=$seq gate=coldstart ticket=$id"
      elif has --offline "${@:3}"; then
        r="$(jq -c --argjson all "$all" '
          [ (if ((.body // "") | test("\\S")) then empty else {what: "missing body"} end),
            (if ((.scope | type) != "array" or (.scope | length) == 0) then {what: "missing scope"}
             elif any(.scope[]; (type != "string") or (test("\\S") | not)) then {what: "invalid scope"} else empty end),
            (if has("rails") and ((.rails | type) != "array" or any(.rails[]; (type != "string") or (test("\\S") | not)))
             then {what: "invalid rails"} else empty end),
            ((.edges // [])[] | .to as $to | if any($all[]; .id == $to) then empty
             else {what: "unknown edge target", why_blocking: "edge points to unknown ticket \($to)"} end) ] as $g
          | {ok: ($g == []), results: [{id, pass: ($g == []), gaps: $g, cached: false, offline: true}]}' <<<"$t")"
        printf '%s\n' "$r"
        jq -e .ok <<<"$r" >/dev/null || exit 2
      else echo "fake adlc: coldstart needs --offline or --prompt-only" >&2; exit 2; fi ;;
    "merge-forecast --json"|"merge-forecast "*)
      jq -e 'any(.[]; .completed != true)' <<<"$all" >/dev/null || { echo "error: no active tickets found (all tickets are completed)" >&2; exit 1; }
      files="$(git -C "$TOP" ls-files)"
      warn='[]'
      while IFS=$'\t' read -r id globs; do
        [ -n "$id" ] || continue
        if [ "$globs" = '[]' ]; then warn="$(jq -c --arg id "$id" '. + ["ticket \"\($id)\" has no scope defined"]' <<<"$warn")"; continue; fi
        hit=0
        while IFS= read -r g; do
          while IFS= read -r f; do
            # shellcheck disable=SC2053  # the glob is a pattern on purpose
            [ -n "$f" ] && [[ "$f" == $g ]] && { hit=1; break; }
          done <<<"$files"
          [ "$hit" = 0 ] || break
        done < <(jq -r '.[]' <<<"$globs")
        [ "$hit" = 1 ] || warn="$(jq -c --arg id "$id" '. + ["ticket \"\($id)\" scope matches 0 files in repo"]' <<<"$warn")"
      done < <(jq -r '.[] | select(.completed != true) | [.id, (.scope // [] | tojson)] | @tsv' <<<"$all")
      jq -c --argjson warn "$warn" '[.[] | select(.completed != true)] as $open
        | ($open | map(.id)) as $ids
        | (reduce $open[] as $p ({}; reduce ($p.edges // [])[] as $e (.; if ($e.to | IN($ids[])) then .[$e.to] += [$p.id] else . end))) as $deps
        | {waves: [], done: []}
        | until(([.done[]] | length) == ($ids | length);
            .done as $d
            | [ $ids[] as $i | select(($i | IN($d[])) | not) | select(all(($deps[$i] // [])[]; IN($d[]))) | $i ] as $w
            | if ($w | length) == 0 then error("cycle") else .waves += [$w | sort] | .done += $w end)
        | {pairs: [], waves, mergeOrder: [.waves[][]], firstWaveWidth: (.waves[0] | length),
           certifiedWidth: (.waves[0] | length), warnings: $warn, gateFailures: []}' <<<"$all" ;;
    *) echo "fake adlc: unsupported command: $*" >&2; exit 2 ;;
  esac
  exit 0
fi

case "${1:-} ${2:-}" in
  "ticket list")
    [ "${3:-}" = --json ] || { echo "fake adlc: ticket list needs --json" >&2; exit 2; }
    jq -c 'map(with_entries(select(.key | IN("id", "title", "ticketHash"))))' <<<"$raw" ;;
  "ticket show")
    id="${3:?fake adlc: ticket show needs an id}"
    has --json "${@:4}" || { echo "fake adlc: ticket show needs --json" >&2; exit 2; }
    t="$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<<"$tickets")"
    [ -n "$t" ] || not_found "$id"
    jq -c '{ticket: del(.ticketHash), ticketHash, storeHash: "store-fake"}' <<<"$t" ;;
  "ticket complete")
    [ -n "${FAKE_ADLC_STORE:-}" ] || { echo "fake adlc: ticket complete needs FAKE_ADLC_STORE" >&2; exit 2; }
    id="${3:?fake adlc: ticket complete needs an id}"
    jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$tickets" >/dev/null || not_found "$id"
    write=0
    if has --write "${@:4}"; then
      has --authorize "${@:4}" || { echo "fake adlc: complete --write needs --authorize in this fake" >&2; exit 2; }
      write=1
    fi
    jq -cn --arg id "$id" --argjson w "$write" \
      '{version: 1, operation: "complete", ticketId: $id, changedFields: ["completed"], dryRun: ($w == 0)}'
    if [ "$write" = 1 ]; then
      bypass=false
      if jq -e 'any(.[]; (.rails | type) == "array" and (.rails | length) > 0)' <<<"$tickets" >/dev/null; then
        if ! has --allow-unsigned "${@:4}"; then
          jq -cn '{ok: false, kind: "policy", code: "MANIFEST_KEY_REQUIRED",
                   message: "this ticket store is a frozen trust root (a ticket declares rails), so mutating it is an audited override — and ADLC_MANIFEST_KEY is not set. Refusing before the write: nothing has changed. To record an UNSIGNED audit entry on purpose, pass --allow-unsigned."}' >&2
          exit 2
        fi
        echo "warning: --allow-unsigned with no ADLC_MANIFEST_KEY — this mutation of a frozen trust root will be recorded UNSIGNED." >&2
        bypass=true
      fi
      tmp="$(mktemp "$FAKE_ADLC_STORE.XXXXXX")"
      jq --arg id "$id" 'map(if .id == $id then .completed = true else . end)' "$FAKE_ADLC_STORE" >"$tmp"
      mv "$tmp" "$FAKE_ADLC_STORE"
      mkdir -p .adlc
      jq -cn --arg id "$id" --argjson b "$bypass" \
        '{gate: "ticket-complete", ticket: $id, data: ({operation: "complete", action: "apply"} + if $b then {bypass: true} else {} end)}' >>"$MANIFEST"
      jq -cn --arg id "$id" '{applied: true, storeHash: "store-fake", ticketHash: "hash-\($id)-done"}'
    fi ;;
  "gate-manifest show")
    has --json "${@:3}" || { echo "fake adlc: gate-manifest show needs --json" >&2; exit 2; }
    want=""
    set -- "${@:3}"
    while [ $# -gt 0 ]; do [ "$1" = --ticket ] && { want="${2:?--ticket needs an id}"; shift; }; shift; done
    { [ -f "$MANIFEST" ] && command cat "$MANIFEST"; true; } |
      jq -sc --arg t "$want" --argjson skipped "${FAKE_ADLC_SKIPPED:-[]}" \
        '{entries: [.[] | select($t == "" or .ticket == $t) | . + {gate: (.gate // .type), segment: "root"}], skipped: $skipped}' ;;
  "merge-forecast --json"|"merge-forecast "*)
    [[ " $* " == *" --json "* ]] || { echo "fake adlc: merge-forecast needs --json" >&2; exit 2; }
    if [ -n "${FAKE_ADLC_FORECAST:-}" ]; then jq -c . <<<"$FAKE_ADLC_FORECAST"
    elif ! jq -e 'any(.[]; .completed != true)' <<<"$tickets" >/dev/null; then
      echo "error: no active tickets found (all tickets are completed)" >&2; exit 1
    else jq -c '[.[] | select(.completed != true) | .id] | sort
                | {pairs: [], waves: [.], mergeOrder: ., firstWaveWidth: length,
                   certifiedWidth: length, warnings: [], gateFailures: []}' <<<"$tickets"
    fi
    exit "${FAKE_ADLC_FORECAST_EXIT:-0}" ;;
  *) echo "fake adlc: unsupported command: $*" >&2; exit 2 ;;
esac
