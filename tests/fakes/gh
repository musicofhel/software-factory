#!/usr/bin/env bash
# Fake `gh` for offline tests. Put tests/fakes on PATH; tests/fakes/lib.sh sets it up.
#
# It records every call and emulates the slice of the GitHub API the factory scripts rely on.
# Refs and commits live in a real bare git repo, so the ref compare-and-swap is git's own atomic
# update-ref, not a re-implementation. Issues live in a JSON file guarded by flock.
#
#   FAKE_GH_GIT        bare repo backing repos/<FAKE_GH_REPO>/git/*            (required for api)
#   FAKE_GH_ISSUES     {"labels": [names], "issues": [...]} backing `issue`   (required for issue)
#   FAKE_GH_SETTINGS   {"protection": {branch: PUT body}, "rulesets": [...], "next_id": n} backing
#                      branches/<b>/protection and rulesets                    (required for those)
#   FAKE_GH_REPO       the one repo this fake serves (default test/repo); anything else is 404
#   FAKE_GH_LOG        every call appended as one JSON array of its argv
#   FAKE_GH_USER       who @me is (default fake-user)
#   FAKE_GH_BOT        1: @me is a bot (Issues it creates answer author.is_bot true)
#   FAKE_GH_NOW        server clock in epoch seconds, stamped on created commits and comments
#   FAKE_GH_FAIL       ERE; a call whose joined argv matches fails with HTTP 500
#   FAKE_GH_RACE_REFS  space-separated refs; when a POST git/refs for one arrives, another node
#                      ("racer") creates it first, so the POST gets the real 422
#
# api:   GET  git/matching-refs/<prefix>, git/ref/<ref>, git/commits/<sha>
#        POST git/commits (message, tree, parents[]), git/refs (ref, sha; 422 if the ref exists)
#        PATCH git/refs/<ref> (sha, force; 422 if missing or not a fast-forward without force)
#        DELETE git/refs/<ref> (422 if missing)
#        GET  branches/<b>/protection (404 "Branch not protected"; answers GitHub's GET shape:
#             {enabled: bool} objects, urls, checks[], defaults for the fields never PUT)
#        PUT  branches/<b>/protection (422 unless the four required keys are present; 404 for a
#             branch the bare repo lacks)
#        GET  rulesets (summaries only, no rules: callers must GET by id), rulesets/<id>
#        POST rulesets, PUT rulesets/<id> (422 on a duplicate name or an unknown rule type)
#        A ?query on the path is ignored. --input FILE|- sends a JSON body (as gh does).
#        Like gh: -f/-F fields (key[]=v arrays, -F typed), POST by default when fields are given,
#        --jq on success, error body on stdout + "gh: <msg> (HTTP <code>)" on stderr, exit 1.
# issue: list (--label repeatable = AND, --state, --limit default 30, --json fields, newest first;
#        state is answered OPEN/CLOSED, a missing body as "" and a missing author as a human
#        {"login": "someone", "is_bot": false}, as gh does),
#        create (--title, --body | --body-file, --label repeatable; unknown repo labels fail; the
#        number is max(issue, PR numbers) + 1; prints the Issue URL; the author is @me, a bot
#        when FAKE_GH_BOT=1),
#        edit (--title, --body | --body-file, --add/--remove-assignee, --add/--remove-label;
#        unknown repo labels fail),
#        close (--reason completed|"not planned", --comment), reopen,
#        comment (--body | --body-file). --repo is required: a test never falls back to a remote.
# label: list (--json name, --limit default 30), create <name> (--color, --description; fails
#        when the label exists unless --force).
# pr:    list (--state open|closed|merged|all, default open; --head <branch>; --limit default 30;
#        --json fields; newest first) on the "pulls" array of FAKE_GH_ISSUES: {number, headRefName,
#        state: OPEN|CLOSED|MERGED, createdAt}.
set -euo pipefail

REPO="${FAKE_GH_REPO:-test/repo}"
ME="${FAKE_GH_USER:-fake-user}"

if [ -n "${FAKE_GH_LOG:-}" ]; then
  entry="$(for a in "$@"; do jq -n --arg a "$a" '$a'; done | jq -sc .)"
  printf '%s\n' "$entry" >>"$FAKE_GH_LOG"
fi

http_err() {  # http_err <code> <message>
  jq -cn --arg m "$2" --arg c "$1" '{message: $m, status: $c}'
  printf 'gh: %s (HTTP %s)\n' "$2" "$1" >&2
  exit 1
}
fail() { printf '%s\n' "$*" >&2; exit 1; }

if [ -n "${FAKE_GH_FAIL:-}" ] && [[ "$*" =~ $FAKE_GH_FAIL ]]; then http_err 500 "Server Error (injected)"; fi

server_date() { if [ -n "${FAKE_GH_NOW:-}" ]; then printf '%s +0000\n' "$FAKE_GH_NOW"; else printf '%s +0000\n' "$(date -u +%s)"; fi; }

# ---------------------------------------------------------------- api
g() { git -C "$FAKE_GH_GIT" "$@"; }

commit_json() {  # commit_json <sha>
  local s="$1"
  g cat-file -e "$s^{commit}" 2>/dev/null || http_err 404 "Not Found"
  jq -n --arg sha "$s" --arg tree "$(g rev-parse "$s^{tree}")" \
        --arg parents "$(g show -s --format=%P "$s")" \
        --arg date "$(TZ=UTC g show -s --format=%cd --date=format-local:%Y-%m-%dT%H:%M:%SZ "$s")" \
        --arg name "$(g show -s --format=%cn "$s")" \
        --rawfile msg <(g cat-file commit "$s" | sed '1,/^$/d') \
    '{sha: $sha, tree: {sha: $tree}, parents: [$parents | splits(" ") | select(. != "") | {sha: .}],
      message: ($msg | rtrimstr("\n")),
      author: {name: $name, date: $date}, committer: {name: $name, date: $date}}'
}

ref_json() { jq -n --arg r "$1" --arg s "$2" '{ref: $r, object: {sha: $s, type: "commit"}}'; }
ref_sha() { g show-ref --verify -s "$1" 2>/dev/null || true; }

api() {
  local method="" path="" jqx="" fields='{}' k v explicit=0 input="" explicit_body=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -X|--method) method="$2"; explicit=1; shift ;;
      -f|--raw-field|-F|--field)
        k="${2%%=*}"; v="${2#*=}"
        if [ "$1" = -F ] || [ "$1" = --field ]; then
          case "$v" in true|false|null) v="$v" ;; *) [[ "$v" =~ ^-?[0-9]+$ ]] || v="$(jq -n --arg v "$v" '$v')" ;; esac
        else v="$(jq -n --arg v "$v" '$v')"; fi
        if [[ "$k" == *"[]" ]]; then fields="$(jq -c --arg k "${k%[]}" --argjson v "$v" '.[$k] += [$v]' <<<"$fields")"
        else fields="$(jq -c --arg k "$k" --argjson v "$v" '.[$k] = $v' <<<"$fields")"; fi
        shift ;;
      --jq|-q) jqx="$2"; shift ;;
      --input) input="$2"; shift ;;
      -H|--header) shift ;;
      --paginate|--silent) ;;
      -*) fail "fake gh api: unsupported flag $1" ;;
      *) [ -z "$path" ] || fail "fake gh api: two paths"; path="${1#/}" ;;
    esac
    shift
  done
  if [ -n "$input" ]; then
    [ "$fields" = '{}' ] || fail "fake gh api: --input and -f/-F together are not supported"
    if [ "$input" = - ]; then fields="$(command cat)"; else fields="$(command cat "$input")"; fi
    fields="$(jq -c . <<<"$fields" 2>/dev/null)" || http_err 400 "Problems parsing JSON"
    explicit_body=1
  fi
  [ "$explicit" = 1 ] || { if [ "$fields" != '{}' ] || [ -n "$explicit_body" ]; then method=POST; else method=GET; fi; }
  path="${path%%\?*}"
  case "$path" in "repos/$REPO/"*) path="${path#"repos/$REPO/"}" ;; *) http_err 404 "Not Found" ;; esac
  case "$path" in
    branches/*/protection|rulesets|rulesets/*) settings "$method" "$path" "$fields" "$jqx"; return ;;
  esac
  : "${FAKE_GH_GIT:?fake gh api needs FAKE_GH_GIT}"
  f() { jq -r --arg k "$1" '.[$k] // empty' <<<"$fields"; }

  local out="" ref sha old tree p
  case "$method $path" in
    "GET git/matching-refs/"*)
      out="$(g for-each-ref --format='%(refname) %(objectname)' |
             jq -R --arg p "refs/${path#git/matching-refs/}" \
               'split(" ") | select(.[0] | startswith($p)) | {ref: .[0], object: {sha: .[1], type: "commit"}}' |
             jq -s .)" ;;
    "GET git/ref/"*)
      ref="refs/${path#git/ref/}"; sha="$(ref_sha "$ref")"
      [ -n "$sha" ] || http_err 404 "Not Found"
      out="$(ref_json "$ref" "$sha")" ;;
    "GET git/commits/"*)
      sha="${path#git/commits/}"
      g cat-file -e "$sha^{commit}" 2>/dev/null || http_err 404 "Not Found"
      out="$(commit_json "$sha")" ;;
    "POST git/commits")
      tree="$(f tree)"
      [ -n "$tree" ] && g cat-file -e "$tree^{tree}" 2>/dev/null || http_err 422 "Tree SHA does not exist"
      local -a pargs=()
      while read -r p; do
        [ -n "$p" ] || continue
        g cat-file -e "$p^{commit}" 2>/dev/null || http_err 422 "Parent SHA does not exist or is not a commit object"
        pargs+=(-p "$p")
      done < <(jq -r '.parents // [] | .[]' <<<"$fields")
      sha="$(f message | GIT_AUTHOR_NAME="$ME" GIT_AUTHOR_EMAIL="$ME@fake" GIT_COMMITTER_NAME="$ME" \
             GIT_COMMITTER_EMAIL="$ME@fake" GIT_AUTHOR_DATE="$(server_date)" GIT_COMMITTER_DATE="$(server_date)" \
             g commit-tree "$tree" "${pargs[@]}")"
      out="$(commit_json "$sha")" ;;
    "POST git/refs")
      ref="$(f ref)"; sha="$(f sha)"
      [[ "$ref" =~ ^refs/[^/]+/.+ ]] || http_err 422 "Reference name is invalid"
      [ -n "$sha" ] && g cat-file -e "$sha" 2>/dev/null || http_err 422 "Object does not exist"
      if [[ " ${FAKE_GH_RACE_REFS:-} " == *" $ref "* ]]; then
        local racer
        racer="$(printf 'lock %s: racer\n\n{"handle":"racer","run_id":"racer-1","slots":1,"claimed_at":"1970-01-01T00:00:00Z"}' "${ref#refs/locks/}" |
                 GIT_AUTHOR_NAME=racer GIT_AUTHOR_EMAIL=racer@fake GIT_COMMITTER_NAME=racer \
                 GIT_COMMITTER_EMAIL=racer@fake GIT_AUTHOR_DATE="$(server_date)" GIT_COMMITTER_DATE="$(server_date)" \
                 g commit-tree "$(g rev-parse "$sha^{tree}")")"
        g update-ref "$ref" "$racer" "" 2>/dev/null || true
      fi
      g update-ref "$ref" "$sha" "" 2>/dev/null || http_err 422 "Reference already exists"
      out="$(ref_json "$ref" "$sha")" ;;
    "PATCH git/refs/"*)
      ref="refs/${path#git/refs/}"; sha="$(f sha)"; old="$(ref_sha "$ref")"
      [ -n "$old" ] || http_err 422 "Reference does not exist"
      [ -n "$sha" ] && g cat-file -e "$sha" 2>/dev/null || http_err 422 "Object does not exist"
      if [ "$(jq -r '.force // false' <<<"$fields")" != true ]; then
        g merge-base --is-ancestor "$old" "$sha" 2>/dev/null || http_err 422 "Update is not a fast forward"
      fi
      g update-ref "$ref" "$sha" "$old" 2>/dev/null || http_err 422 "Reference cannot be updated"
      out="$(ref_json "$ref" "$sha")" ;;
    "DELETE git/refs/"*)
      ref="refs/${path#git/refs/}"; old="$(ref_sha "$ref")"
      [ -n "$old" ] || http_err 422 "Reference does not exist"
      g update-ref -d "$ref" "$old" 2>/dev/null || http_err 422 "Reference cannot be deleted"
      return 0 ;;
    *) http_err 404 "Not Found" ;;
  esac
  if [ -n "$jqx" ]; then jq -r "$jqx" <<<"$out"; else printf '%s\n' "$out"; fi
}

# ---------------------------------------------------------------- settings (protection, rulesets)
smutate() {  # smutate <jq program> [jq args...]: atomic read-modify-write of the settings store
  local prog="$1"; shift
  (
    flock 9
    local tmp; tmp="$(mktemp "$FAKE_GH_SETTINGS.XXXXXX")"
    jq "$@" "$prog" "$FAKE_GH_SETTINGS" >"$tmp" && mv "$tmp" "$FAKE_GH_SETTINGS"
  ) 9>"$FAKE_GH_SETTINGS.lock"
}

RULE_TYPES='["creation","update","deletion","required_linear_history","merge_queue","required_deployments",
  "required_signatures","pull_request","required_status_checks","non_fast_forward","commit_message_pattern",
  "commit_author_email_pattern","committer_email_pattern","branch_name_pattern","tag_name_pattern",
  "file_path_restriction","max_file_path_length","file_extension_restriction","max_file_size","workflows",
  "code_scanning","copilot_code_review"]'

settings() {  # settings <method> <path below repos/R/> <body-json> <jq>
  : "${FAKE_GH_SETTINGS:?fake gh api needs FAKE_GH_SETTINGS for protection and rulesets}"
  local method="$1" path="$2" body="$3" jqx="$4" out="" b id url="https://api.github.com/repos/$REPO"
  # What GitHub answers to GET protection: wrapped booleans, urls, checks, and defaults.
  local render_prot='def w($v): {enabled: ($v // false)};
    . as $p | {url: "\($u)/branches/\($b)/protection"}
    + (if $p.required_status_checks == null then {} else {required_status_checks: ($p.required_status_checks
        + {url: "\($u)/branches/\($b)/protection/required_status_checks", contexts_url: "x",
           checks: [$p.required_status_checks.contexts[]? | {context: ., app_id: null}]})} end)
    + (if $p.required_pull_request_reviews == null then {} else {required_pull_request_reviews:
        ({url: "x", dismiss_stale_reviews: false, require_code_owner_reviews: false,
          require_last_push_approval: false, required_approving_review_count: 0} + $p.required_pull_request_reviews)} end)
    + (if $p.restrictions == null then {} else {restrictions: {url: "x",
        users: [($p.restrictions.users // [])[] | {login: .}], teams: [($p.restrictions.teams // [])[] | {slug: .}],
        apps: [($p.restrictions.apps // [])[] | {slug: .}]}} end)
    + {required_signatures: {url: "x", enabled: false}, enforce_admins: {url: "x", enabled: ($p.enforce_admins // false)},
       required_linear_history: w($p.required_linear_history), allow_force_pushes: w($p.allow_force_pushes),
       allow_deletions: w($p.allow_deletions), block_creations: w($p.block_creations),
       required_conversation_resolution: w($p.required_conversation_resolution), lock_branch: w($p.lock_branch),
       allow_fork_syncing: w($p.allow_fork_syncing)}'
  # What GitHub answers to GET rulesets/<id>: the stored body plus server fields and rule defaults.
  local render_rs='. + {source_type: "Repository", source: $r, node_id: "RRS_\(.id)", current_user_can_bypass: "never",
      bypass_actors: (.bypass_actors // []), created_at: "2026-10-24T00:00:00Z", updated_at: "2026-10-24T00:00:00Z",
      _links: {self: {href: "\($u)/rulesets/\(.id)"}},
      rules: [(.rules // [])[] | if .type == "pull_request"
                then .parameters = ({allowed_merge_methods: ["merge", "squash", "rebase"]} + (.parameters // {}))
                else . end]}'
  local check_rs='def bad: (if (.name // "") == "" then "Name can'"'"'t be blank" else empty end),
      ([(.rules // [])[].type | select(IN($types[]) | not)] | if length > 0 then "Invalid rule \(.[0])" else empty end),
      (.enforcement // "active" | if IN("active", "disabled", "evaluate") then empty else "Invalid enforcement" end);
    [bad][0] // empty'
  case "$method $path" in
    "GET branches/"*/protection|"PUT branches/"*/protection)
      b="${path#branches/}"; b="${b%/protection}"
      [ -n "${FAKE_GH_GIT:-}" ] && git -C "$FAKE_GH_GIT" show-ref --verify -q "refs/heads/$b" || http_err 404 "Branch not found"
      if [ "$method" = PUT ]; then
        local miss
        miss="$(jq -r '["required_status_checks", "enforce_admins", "required_pull_request_reviews", "restrictions"][]
                       as $k | select(has($k) | not)' <<<"$body" | head -n1)"
        [ -z "$miss" ] || http_err 422 "Invalid request. \"$miss\" wasn't supplied."
        smutate '.protection[$b] = $p' --arg b "$b" --argjson p "$body"
      fi
      jq -e --arg b "$b" '.protection[$b] != null' "$FAKE_GH_SETTINGS" >/dev/null || http_err 404 "Branch not protected"
      out="$(jq --arg b "$b" --arg u "$url" ".protection[\$b] | $render_prot" "$FAKE_GH_SETTINGS")" ;;
    "GET rulesets")
      out="$(jq --arg r "$REPO" '[.rulesets[] | {id, name, target, source_type: "Repository", source: $r, enforcement}]' "$FAKE_GH_SETTINGS")" ;;
    "POST rulesets")
      b="$(jq -r --argjson types "$RULE_TYPES" "$check_rs" <<<"$body")"
      [ -z "$b" ] || http_err 422 "Validation Failed: $b"
      jq -e --argjson x "$body" 'any(.rulesets[]; .name == $x.name)' "$FAKE_GH_SETTINGS" >/dev/null &&
        http_err 422 "Validation Failed: Name must be unique"
      smutate '.next_id = ((.next_id // 1) + 1) | .rulesets += [{id: (.next_id - 1)} + ($x | del(.id))]' --argjson x "$body"
      id="$(jq '.next_id - 1' "$FAKE_GH_SETTINGS")"
      out="$(jq --argjson id "$id" --arg r "$REPO" --arg u "$url" ".rulesets[] | select(.id == \$id) | $render_rs" "$FAKE_GH_SETTINGS")" ;;
    "GET rulesets/"*|"PUT rulesets/"*)
      id="${path#rulesets/}"
      [[ "$id" =~ ^[0-9]+$ ]] && jq -e --argjson id "$id" 'any(.rulesets[]; .id == $id)' "$FAKE_GH_SETTINGS" >/dev/null ||
        http_err 404 "Not Found"
      if [ "$method" = PUT ]; then
        b="$(jq -r --argjson types "$RULE_TYPES" "$check_rs" <<<"$(jq -c --argjson id "$id" --argjson x "$body" \
              '.rulesets[] | select(.id == $id) | . + $x' "$FAKE_GH_SETTINGS")")"
        [ -z "$b" ] || http_err 422 "Validation Failed: $b"
        jq -e --argjson id "$id" --argjson x "$body" 'any(.rulesets[]; .id != $id and .name == ($x.name // null))' \
          "$FAKE_GH_SETTINGS" >/dev/null && http_err 422 "Validation Failed: Name must be unique"
        smutate '(.rulesets[] | select(.id == $id)) |= (. + ($x | del(.id)))' --argjson id "$id" --argjson x "$body"
      fi
      out="$(jq --argjson id "$id" --arg r "$REPO" --arg u "$url" ".rulesets[] | select(.id == \$id) | $render_rs" "$FAKE_GH_SETTINGS")" ;;
    *) http_err 404 "Not Found" ;;
  esac
  if [ -n "$jqx" ]; then jq -r "$jqx" <<<"$out"; else printf '%s\n' "$out"; fi
}

# ---------------------------------------------------------------- issue
mutate() {  # mutate <jq program> [jq args...]: atomic read-modify-write of the issue store
  local prog="$1"; shift
  (
    flock 9
    local tmp; tmp="$(mktemp "$FAKE_GH_ISSUES.XXXXXX")"
    jq "$@" "$prog" "$FAKE_GH_ISSUES" >"$tmp" && mv "$tmp" "$FAKE_GH_ISSUES"
  ) 9>"$FAKE_GH_ISSUES.lock"
}

issue() {
  : "${FAKE_GH_ISSUES:?fake gh issue needs FAKE_GH_ISSUES}"
  local sub="${1:-}"; shift || true
  local repo="" n="" labels='[]' state=open limit=30 fields="" body="" have_body=0 title="" have_title=0
  local add_a='[]' rm_a='[]' add_l='[]' rm_l='[]' reason="" comment="" have_comment=0
  csv() { jq -c --arg v "$2" --arg me "$ME" '. + ($v | split(",") | map(if . == "@me" then $me else . end))' <<<"$1"; }
  while [ $# -gt 0 ]; do
    case "$1" in
      -R|--repo) repo="$2"; shift ;;
      -l|--label) labels="$(csv "$labels" "$2")"; shift ;;
      -s|--state) state="$2"; shift ;;
      -L|--limit) limit="$2"; shift ;;
      --json) fields="$2"; shift ;;
      -t|--title) title="$2"; have_title=1; shift ;;
      --add-assignee) add_a="$(csv "$add_a" "$2")"; shift ;;
      --remove-assignee) rm_a="$(csv "$rm_a" "$2")"; shift ;;
      --add-label) add_l="$(csv "$add_l" "$2")"; shift ;;
      --remove-label) rm_l="$(csv "$rm_l" "$2")"; shift ;;
      -b|--body) body="$2"; have_body=1; shift ;;
      -F|--body-file) if [ "$2" = - ]; then body="$(command cat)"; else body="$(command cat "$2")"; fi; have_body=1; shift ;;
      -r|--reason) reason="$2"; shift ;;
      -c|--comment) comment="$2"; have_comment=1; shift ;;
      -*) fail "fake gh issue $sub: unsupported flag $1" ;;
      *) [ -z "$n" ] || fail "fake gh issue $sub: two positionals"; n="$1" ;;
    esac
    shift
  done
  [ -n "$repo" ] || fail "fake gh issue: --repo is required (tests never infer the repo from a remote)"
  [ "$repo" = "$REPO" ] || fail "GraphQL: Could not resolve to a Repository with the name '$repo'."
  local at="${FAKE_GH_NOW:-$(date -u +%s)}" missing
  unknown_labels() { jq -r --argjson l "$1" '.labels as $known | $l[] | select(IN($known[]) | not)' "$FAKE_GH_ISSUES" | head -n1; }
  case "$sub" in
    list)
      [ -n "$fields" ] || fail "fake gh issue list: needs --json"
      jq -c --argjson want "$labels" --arg state "$state" --argjson limit "$limit" \
            --argjson f "$(jq -cn --arg f "$fields" '$f | split(",")')" '
        [ .issues[]
          | select($state == "all" or .state == $state)
          | select([.labels[].name] as $have | all($want[]; IN($have[]))) ]
        | sort_by(.createdAt) | reverse | .[:$limit]
        | map({body: "", author: {login: "someone", is_bot: false}} + .
              | .state |= ascii_upcase | with_entries(select(.key | IN($f[]))))' "$FAKE_GH_ISSUES" ;;
    create)
      [ -z "$n" ] || fail "fake gh issue create: unexpected argument $n"
      [ "$have_title" = 1 ] && [ -n "$title" ] || fail "fake gh issue create: needs --title (it would prompt)"
      [ "$have_body" = 1 ] || fail "fake gh issue create: needs --body or --body-file (it would prompt)"
      missing="$(unknown_labels "$labels")"
      [ -z "$missing" ] || fail "could not add label: '$missing' not found"
      mutate '([.issues[].number, (.pulls // [])[].number] | max // 0) as $max
              | .issues += [{number: ($max + 1), title: $t, body: $b, state: "open", createdAt: ($at | todate),
                             labels: ($l | unique | map({name: .})), assignees: [], comments: [],
                             author: {login: $me, is_bot: $bot}}]' \
        --arg t "$title" --arg b "$body" --argjson l "$labels" --argjson at "$at" --arg me "$ME" \
        --argjson bot "$([ "${FAKE_GH_BOT:-0}" = 1 ] && echo true || echo false)"
      printf 'https://github.com/%s/issues/%s\n' "$REPO" "$(jq '[.issues[].number] | max' "$FAKE_GH_ISSUES")" ;;
    edit|comment|close|reopen)
      [[ "$n" =~ ^[0-9]+$ ]] && jq -e --argjson n "$n" 'any(.issues[]; .number == $n)' "$FAKE_GH_ISSUES" >/dev/null ||
        fail "GraphQL: Could not resolve to an issue or pull request with the number of $n."
      case "$sub" in
        edit)
          [ "$have_title" = 0 ] || [ -n "$title" ] || fail "fake gh issue edit: empty --title"
          missing="$(unknown_labels "$add_l")"
          [ -z "$missing" ] || fail "could not add label: '$missing' not found"
          mutate '(.issues[] | select(.number == $n)) |= (
                    .assignees = ([.assignees[].login] + $aa | unique | map(select(IN($ra[]) | not)) | map({login: .}))
                  | .labels = ([.labels[].name] + $al | unique | map(select(IN($rl[]) | not)) | map({name: .}))
                  | if $ht then .title = $t else . end
                  | if $hb then .body = $b else . end)' \
            --argjson n "$n" --argjson aa "$add_a" --argjson ra "$rm_a" --argjson al "$add_l" --argjson rl "$rm_l" \
            --argjson ht "$([ "$have_title" = 1 ] && echo true || echo false)" --arg t "$title" \
            --argjson hb "$([ "$have_body" = 1 ] && echo true || echo false)" --arg b "$body"
          printf 'https://github.com/%s/issues/%s\n' "$REPO" "$n" ;;
        close)
          case "$reason" in ""|completed|"not planned") ;; *) fail "invalid argument \"$reason\" for \"-r, --reason\" flag" ;; esac
          jq -e --argjson n "$n" '.issues[] | select(.number == $n) | .state == "open"' "$FAKE_GH_ISSUES" >/dev/null ||
            { printf '! Issue #%s is already closed\n' "$n" >&2; return 0; }
          mutate '(.issues[] | select(.number == $n)) |= (.state = "closed" | .stateReason = ($r | if . == "" then "completed" else . end)
                  | if $hc then .comments += [{author: {login: $me}, body: $c, createdAt: ($at | todate)}] else . end)' \
            --argjson n "$n" --arg r "$reason" --argjson hc "$([ "$have_comment" = 1 ] && echo true || echo false)" \
            --arg c "$comment" --arg me "$ME" --argjson at "$at"
          printf '✓ Closed issue #%s\n' "$n" >&2 ;;
        reopen)
          jq -e --argjson n "$n" '.issues[] | select(.number == $n) | .state == "closed"' "$FAKE_GH_ISSUES" >/dev/null ||
            { printf '! Issue #%s is already open\n' "$n" >&2; return 0; }
          mutate '(.issues[] | select(.number == $n)) |= (.state = "open" | del(.stateReason))' --argjson n "$n"
          printf '✓ Reopened issue #%s\n' "$n" >&2 ;;
        comment)
          [ "$have_body" = 1 ] || fail "fake gh issue comment: needs --body or --body-file"
          mutate '(.issues[] | select(.number == $n)).comments += [{author: {login: $me}, body: $b, createdAt: ($at | todate)}]' \
            --argjson n "$n" --arg me "$ME" --arg b "$body" --argjson at "$at"
          printf 'https://github.com/%s/issues/%s#issuecomment-%s\n' "$REPO" "$n" "$(jq --argjson n "$n" '.issues[] | select(.number == $n) | .comments | length' "$FAKE_GH_ISSUES")" ;;
      esac ;;
    *) fail "fake gh issue: unsupported subcommand '$sub'" ;;
  esac
}

label() {
  : "${FAKE_GH_ISSUES:?fake gh label needs FAKE_GH_ISSUES}"
  local sub="${1:-}"; shift || true
  local repo="" name="" fields="" limit=30 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -R|--repo) repo="$2"; shift ;;
      --json) fields="$2"; shift ;;
      -L|--limit) limit="$2"; shift ;;
      -c|--color|-d|--description) shift ;;
      -f|--force) force=1 ;;
      -*) fail "fake gh label $sub: unsupported flag $1" ;;
      *) [ -z "$name" ] || fail "fake gh label $sub: two positionals"; name="$1" ;;
    esac
    shift
  done
  [ -n "$repo" ] || fail "fake gh label: --repo is required (tests never infer the repo from a remote)"
  [ "$repo" = "$REPO" ] || fail "GraphQL: Could not resolve to a Repository with the name '$repo'."
  case "$sub" in
    list)
      [ "$fields" = name ] || fail "fake gh label list: only --json name is emulated"
      jq -c --argjson limit "$limit" '[.labels[:$limit][] | {name: .}]' "$FAKE_GH_ISSUES" ;;
    create)
      [ -n "$name" ] || fail "fake gh label create: needs a name"
      if jq -e --arg l "$name" 'any(.labels[]; ascii_downcase == ($l | ascii_downcase))' "$FAKE_GH_ISSUES" >/dev/null; then
        [ "$force" = 1 ] || fail "label with name \"$name\" already exists; use \`--force\` to update its color and description"
      else
        mutate '.labels += [$l]' --arg l "$name"
      fi
      printf '✓ Label "%s" created in %s\n' "$name" "$REPO" >&2 ;;
    *) fail "fake gh label: unsupported subcommand '$sub'" ;;
  esac
}

pr() {
  : "${FAKE_GH_ISSUES:?fake gh pr needs FAKE_GH_ISSUES}"
  local sub="${1:-}"; shift || true
  local repo="" state=open limit=30 fields="" head=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -R|--repo) repo="$2"; shift ;;
      -s|--state) state="$2"; shift ;;
      -L|--limit) limit="$2"; shift ;;
      -H|--head) head="$2"; shift ;;
      --json) fields="$2"; shift ;;
      *) fail "fake gh pr $sub: unsupported argument $1" ;;
    esac
    shift
  done
  [ -n "$repo" ] || fail "fake gh pr: --repo is required (tests never infer the repo from a remote)"
  [ "$repo" = "$REPO" ] || fail "GraphQL: Could not resolve to a Repository with the name '$repo'."
  [ "$sub" = list ] || fail "fake gh pr: unsupported subcommand '$sub'"
  [ -n "$fields" ] || fail "fake gh pr list: needs --json"
  case "$state" in open|closed|merged|all) ;; *) fail "invalid argument \"$state\" for \"-s, --state\" flag" ;; esac
  jq -c --arg state "$state" --arg head "$head" --argjson limit "$limit" \
        --argjson f "$(jq -cn --arg f "$fields" '$f | split(",")')" '
    [ (.pulls // [])[]
      | select($state == "all" or (.state | ascii_downcase) == $state)
      | select($head == "" or .headRefName == $head) ]
    | sort_by(.createdAt) | reverse | .[:$limit]
    | map(with_entries(select(.key | IN($f[]))))' "$FAKE_GH_ISSUES"
}

case "${1:-}" in
  api) shift; api "$@" ;;
  issue) shift; issue "$@" ;;
  pr) shift; pr "$@" ;;
  label) shift; label "$@" ;;
  *) fail "fake gh: unsupported command '${1:-}'" ;;
esac
