{
  "_comment": "Branch rules as code for `main`. Applied by factory/bin/apply-branch-protection.sh (repo admin, once; re-run after any change here). Admin bypass OFF for everyone, org owners included.",
  "branch": "main",
  "required_status_checks": {
    "strict": true,
    "contexts": ["gates / build-test", "gates / rails-proof", "gates / scope", "gates / tamper", "gates / dependencies", "gates / attest-verify", "gates / commit-check"]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
    "required_approving_review_count": 1
  },
  "restrictions": null,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "required_linear_history": false,
  "lock_branch": false,
  "merge_queue": { "required": true, "merge_method": "merge", "max_entries_to_build": 1 },
  "rulesets": [
    {
      "name": "halt-removal-needs-two",
      "_comment": "Deleting factory/HALT needs two approvals; adding it needs zero. Expressed as a ruleset with a file-path condition on deletion.",
      "target": "branch", "enforcement": "active",
      "conditions": { "ref_name": { "include": ["refs/heads/main"], "exclude": [] } },
      "rules": [{ "type": "pull_request", "parameters": { "required_approving_review_count": 2, "require_code_owner_review": true } }],
      "path_filter": { "paths": ["factory/HALT"], "on": "deletion" }
    }
  ]
}
